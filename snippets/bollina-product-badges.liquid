{%- comment -%}
  Bollina : badges « Nouveau » et « Dernières tailles » sur les cartes produit.
  Ils s'affichent quand le produit porte le mot-clé (tag) « nouveau » ou « dernieres-tailles ».
  Paramètre : product
{%- endcomment -%}
{%- liquid
  assign bollina_tags = product.tags | join: ',' | downcase
  assign bollina_nouveau = false
  assign bollina_dernieres = false
  if product.tags contains 'nouveau' or product.tags contains 'Nouveau'
    assign bollina_nouveau = true
  endif
  if bollina_tags contains 'dernieres-tailles' or bollina_tags contains 'dernières-tailles' or bollina_tags contains 'dernieres tailles' or bollina_tags contains 'dernières tailles'
    assign bollina_dernieres = true
  endif
-%}
{%- if product.available and bollina_nouveau or product.available and bollina_dernieres -%}
  <div class="bollina-badges">
    {%- if bollina_nouveau -%}
      <span class="bollina-badge bollina-badge--nouveau"><span class="bollina-badge__dot" aria-hidden="true"></span>Nouveau</span>
    {%- endif -%}
    {%- if bollina_dernieres -%}
      <span class="bollina-badge bollina-badge--dernieres">Dernières tailles</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .bollina-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: var(--layer-flat, 1);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    pointer-events: none;
  }
  .bollina-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 14px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bollina-badge--nouveau {
    background: #ffffff;
    color: #4a0e1e;
  }
  .bollina-badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #d9466f;
  }
  .bollina-badge--dernieres {
    background: #4a0e1e;
    color: #f2c4cc;
  }
{% endstylesheet %}
