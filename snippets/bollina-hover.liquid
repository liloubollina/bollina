{%- comment -%} Bollina : effets au survol des liens (menu, pied de page, textes, cartes produit) {%- endcomment -%}
<style>
  /* Menu du haut : la case entière se colore (pilule) */
  .menu-list__link-title {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .menu-list__link--active .menu-list__link-title {
    background-color: #f2c4cc;
    color: #4a0e1e !important;
  }
  @media (hover: hover) {
    .menu-list__list-item:hover .menu-list__link-title,
    .menu-list__link:focus-visible .menu-list__link-title {
      background-color: #4a0e1e;
      color: #ffffff !important;
    }

    /* Pied de page : la case entière se colore */
    .menu__item a,
    .footer-utilities a {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 999px;
      text-decoration: none;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    .menu__item a {
      margin-inline-start: -12px;
    }
    .menu__item a:hover,
    .footer-utilities a:hover {
      background-color: #4a0e1e;
      color: #ffffff;
    }
    .rte a:hover,
    .text-block a:hover {
      text-decoration-color: #d9466f;
      text-decoration-thickness: 2px;
    }

    /* Cartes produit : le nom se souligne au survol */
    product-card:hover [role='heading'] {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }
</style>
